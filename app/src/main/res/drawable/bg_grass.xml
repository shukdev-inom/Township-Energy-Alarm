<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/grass" />
        </shape>
    </item>
    <item android:gravity="top|start" android:top="90dp" android:width="90dp" android:height="40dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/soil" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:gravity="top|end" android:top="170dp" android:width="80dp" android:height="40dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/soil" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:gravity="bottom|start" android:bottom="60dp" android:width="70dp" android:height="36dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/soil" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</layer-list>
